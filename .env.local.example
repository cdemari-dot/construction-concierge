# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings → API). Create the project in the ca-central-1 region
# for Canadian data residency — see CLAUDE.md.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service-role key. Keeps RLS bypass server-side only (lib/supabase/admin.ts)
# — never expose this with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Powers the AI agent drawer (app/api/agent/route.ts). Get one from
# console.anthropic.com → API Keys. Without this, the agent returns a
# clear "not configured" error instead of crashing.
ANTHROPIC_API_KEY=sk-ant-...
